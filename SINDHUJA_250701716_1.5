#include<stdio.h>
void reverse(int n)
{
   int count = 1;
   int rev = 0, remainder;
   count++;
   while (n != 0) 
    {
        count++;
        remainder = n % 10;
        count++;
        rev = rev * 10 + remainder;
        count++;
        n/= 10;
        count++;
        
    }
    count++;
    printf("%d",count);
}

int main(){
    int n;
    scanf("%d",&n);
    reverse(n);
}