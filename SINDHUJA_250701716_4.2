#include <stdio.h>

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    int a[n][n];
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            scanf("%d", &a[i][j]);

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (i == 0 && j == 0) continue;
            int top = (i > 0) ? a[i - 1][j] : 0;
            int left = (j > 0) ? a[i][j - 1] : 0;
           
            if (i == 0) a[i][j] += left;
            else if (j == 0) a[i][j] += top;
            else a[i][j] += (top > left) ? top : left;
        }
    }

    printf("%d\n", a[n - 1][n - 1]);
    return 0;
}