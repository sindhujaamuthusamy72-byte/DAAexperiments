#include <stdio.h>
int main(){
    int n;
    scanf("%d",&n);
    int arr[n];
    for (int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    int f = 0;
    int k;scanf("%d",&k);
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < i; j++) {
            if (arr[i] - arr[j] == k || arr[j] - arr[i] == k) {
                f = 1;
            }
        }
    }
    if(f==1){
        printf("1");
    }
    else{
        printf("0");
    }
}
