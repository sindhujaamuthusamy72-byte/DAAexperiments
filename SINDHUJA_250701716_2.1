#include <stdio.h>

int main() {
    int V;
    if (scanf("%d", &V) != 1) return 0;
    // Available denominations in descending order
    int coins[] = {1000, 500, 100, 50, 20, 10, 5, 2, 1};
    int n = sizeof(coins) / sizeof(coins[0]);
    int count = 0;

    for (int i = 0; i < n; i++) {
        if (V >= coins[i]) {
            count += V / coins[i]; // Number of notes/coins of denomination coins[i]
            V %= coins[i];         // Remaining amount to make change for
        }
    }

    printf("%d\n", count);
    return 0;
}