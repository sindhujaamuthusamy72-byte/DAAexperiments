#include<stdio.h>
void function(int n)
{
    int c= 0;
    for(int i=n/2;c++, i<n; i++)
    {
        for(int j=1;c++, j<n; j = 2 * j)
        {
            for(int k=1;c++, k<n; k = k * 2)
            {
                c++;
            }
        }
    }
    c++;
    printf("%d",c);
}

int main(){
    int n;
    scanf("%d",&n);
    function(n);
}