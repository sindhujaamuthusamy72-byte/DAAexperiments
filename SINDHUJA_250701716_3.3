#include<stdio.h>

int func(int arr[], int n, int x){
    int first = 0, last = n-1;
    int floorval = -1;
    
    while( first <= last){
        int mid = first + (last-first) / 2;
        
        if(arr[mid] == x)
            return arr[mid];
        
        else if(arr[mid] < x){
            floorval = arr[mid];
            first = mid+1;
        }
        
        else
            last = mid-1;
    }
    
    return floorval;
}

int main(){
    int n, x;
    scanf("%d", &n);
    int arr[n];
    for(int i=0; i<n; i++){
        scanf("%d", &arr[i]);
    }
    scanf("%d", &x);
    
    printf("%d\n", func(arr, n, x));
    return 0;
}