#include<stdio.h>
void Factor(int n) 
 {
     int count = 0;
     int i;
    for (i = 1; i <= n;++i)
    {
        count++;
     if (n % i== 0)
        {
            count++;
          //printf("%d ", i);
        }        
        count++;
     } 
     count++;
     printf("%d",count);
  }
int main()
{
      int n;
      scanf("%d",&n);
      Factor(n);
  }