#include<stdio.h>
#include<stdlib.h>

int cmp(const void*a,const void*b){
    return *(int*)a-*(int*)b;
}

int main(){
    int n,a[1000];
    long long sum=0;

    scanf("%d",&n);

    for(int i=0;i<n;i++)
        scanf("%d",&a[i]);

    qsort(a,n,sizeof(int),cmp);

    for(int i=0;i<n;i++)
        sum+=a[i]*i;

    printf("%lld",sum);

    return 0;
}