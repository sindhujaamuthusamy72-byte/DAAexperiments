#include <stdio.h>
int upper_bound(int arr[], int size, int x) {
    int low = 0, high = size;
    while (low < high) {
        int mid = low + (high - low) / 2;
        if (arr[mid] <= x) {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    return low;
}

int lengthOfLNDS(int nums[], int n) {
    if (n == 0) return 0;
    
    int tails[n];
    int len = 0;

    for (int i = 0; i < n; i++) {
        int idx = upper_bound(tails, len, nums[i]);
        
        tails[idx] = nums[i];
        if (idx == len) {
            len++;
        }
    }

    return len;
}

int main() 
{
    int n = 9;
    int sequence[] = {-1, 3, 4, 5, 2, 2, 2, 2, 3};
    printf("%d\n", lengthOfLNDS(sequence, n));

    return 0;
}