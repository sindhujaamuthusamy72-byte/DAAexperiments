#include<stdio.h>

int main(){
    int n,a[100],b[100],t,sum=0;
    scanf("%d",&n);

    for(int i=0;i<n;i++)
        scanf("%d",&a[i]);

    for(int i=0;i<n;i++)
        scanf("%d",&b[i]);

    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            if(a[i]>a[j]){
                t=a[i];
                a[i]=a[j];
                a[j]=t;
            }
            if(b[i]<b[j]){
                t=b[i];
                b[i]=b[j];
                b[j]=t;
            }
        }
    }

    for(int i=0;i<n;i++)
        sum+=a[i]*b[i];

    printf("%d",sum);

    return 0;
}