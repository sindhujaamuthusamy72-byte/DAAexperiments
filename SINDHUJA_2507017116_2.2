#include<stdio.h>

int main(){
    int n,m,g[30000],s[30000],t,count=0;
    scanf("%d",&n);
    for(int i=0;i<n;i++)
    scanf("%d",&g[i]);
    scanf("%d",&m);
    for(int i=0;i<m;i++)
    scanf("%d",&s[i]);
    for(int i=0;i<n-1;i++)
        for(int j=i+1;j<n;j++)
            if(g[i]>g[j]){
                t=g[i];g[i]=g[j];g[j]=t;
            }
    for(int i=0;i<m-1;i++)
        for(int j=i+1;j<m;j++)
            if(s[i]>s[j]){
                t=s[i];s[i]=s[j];s[j]=t;
            }
    int i=0,j=0;
    while(i<n&&j<m){
        if(s[j]>=g[i]){
            count++;
            i++;
        }
        j++;
    }
    printf("%d",count);
}